# This repo hosts releases as GitHub Release assets (see the Releases page),
# not as committed files - so there's not much to ignore here day to day.
# This just keeps common OS clutter from accidentally getting committed if a
# build folder or similar ever gets dragged in by mistake.

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store

# Common build/output folders, in case a build ever ends up in this repo
# by mistake instead of being uploaded as a Release asset
dist/
build/
_internal/
*.exe
*.zip
